# Copy this file to .env and fill in what you need.
# Ward runs and protects/watermarks images with NO keys configured at all --
# everything below is optional.

# Get a free key at https://serpapi.com (free tier gives a limited number of
# searches per month -- check current limits on their pricing page) to turn
# on "Check for sightings" (reverse image search via Google Lens). Without
# this, Ward still protects and watermarks images, it just can't search the
# web for them. You can also paste a key into Settings in the app instead of
# setting it here.
SERPAPI_API_KEY=

# Real C2PA provenance manifests (see core/provenance.py) instead of Ward's
# local-only fallback record. Requires a certificate from a CA on the
# official C2PA Trust List (as of writing: SSL.com, Trufo, DigiCert) -- a
# self-signed certificate is rejected by the C2PA library itself, verified
# directly against this build. Point these at your own PEM files if you
# have one; leave blank otherwise (Ward will use the local-only record and
# say so plainly in the UI, never mislabeling it as "C2PA").
C2PA_CERT_PATH=
C2PA_KEY_PATH=

# Only needed if you want to point Ward at a database other than the default
# local SQLite file at instance/ward.db.
# DATABASE_URL=

# Set to 1 to run Flask's dev server in debug mode (auto-reload + the
# in-browser debugger). Leave unset/0 for normal use.
# FLASK_DEBUG=0
